# --- Next.js server (never prefix secrets with NEXT_PUBLIC_) ---
# URL of the FastAPI inference service. Read server-side only.
INFERENCE_URL=http://127.0.0.1:8000
# Request timeout for the inference service, in milliseconds.
INFERENCE_TIMEOUT_MS=30000
# Model input size for live camera frames (multiple of 32). Smaller is faster; stored inspections use VI_IMGSZ.
INFERENCE_LIVE_IMGSZ=480
# Directory for the SQLite database and stored inspection images.
VI_DATA_DIR=./data
# Maximum accepted upload size in megabytes.
VI_MAX_UPLOAD_MB=10

# --- FastAPI inference service (inference/) ---
# Ultralytics YOLO weights (.pt). The default qc-yoloe.pt detects bottle / charger / marker / burn_mark;
# build it with: cd inference && .venv/Scripts/python -m tools.build_qc_model
VI_MODEL_PATH=inference/weights/qc-yoloe.pt
# Maps model labels to profile class keys; unlisted labels are dropped.
VI_VOCAB_PATH=inference/weights/vocabulary.json
# Identifier and version reported by the service for the loaded weights (must match the profile's model).
VI_MODEL_ID=yoloe-qc
VI_MODEL_VERSION=11l-text-vp-v2
# Inference input size (pixels) for stored inspections.
VI_IMGSZ=640
# Extra sizes to warm up at start so the first live frame is not slow (match INFERENCE_LIVE_IMGSZ).
VI_WARMUP_IMGSZ=480
# Comma-separated list of origins allowed to call the service directly (the Next.js server does not need CORS).
VI_CORS_ORIGINS=http://localhost:3000
VI_MAX_UPLOAD_MB=10
